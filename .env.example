# Copier en .env à côté du fichier compose, puis renseigner.
# .env n'est pas suivi par git : c'est là que vont les valeurs propres à la machine.

# Nom d'hôte servi par Traefik (docker-compose.traefik.yml)
DOMAIN=presetbook.exemple.fr

# Dossier de données sur l'hôte (docker-compose.traefik.yml).
# À créer avant le premier démarrage, et à donner à l'uid 1000 :
#   mkdir -p /srv/presetbook-data && sudo chown -R 1000:1000 /srv/presetbook-data
DATA_PATH=/srv/presetbook-data

# Mot de passe HTTP devant tout le site (facultatif) : "utilisateur:motdepasse"
# Les comptes de Presetbook protègent déjà les fiches ; ceci masque le site entier.
BASIC_AUTH=admin:un-vrai-mot-de-passe

# Ouvrir la création de comptes à tout le monde (1) ou la réserver
# aux utilisateurs connectés (vide, valeur par défaut).
# Le bouton « Comptes » permet d'en ouvrir un sans toucher à ceci.
# ALLOW_REGISTER=
